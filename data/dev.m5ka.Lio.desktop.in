[Desktop Entry]
Name=Lio
GenericName=Music Player
Comment=Listen to music from your Navidrome server
# Translators: Search terms to find this application. Do NOT translate or localize the semicolons! The list MUST also end with a semicolon!
Keywords=music;player;navidrome;subsonic;opensubsonic;stream;audio;
Exec=lio %U
Icon=@icon@
Terminal=false
Type=Application
Categories=AudioVideo;Audio;Player;GTK;GNOME;
StartupNotify=true
DBusActivatable=true
SingleMainWindow=true
X-Purism-FormFactor=Workstation;Mobile;
