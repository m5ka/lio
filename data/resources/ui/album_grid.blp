using Gtk 4.0;
using Adw 1;

template $LioAlbumGrid: Adw.NavigationPage {
  title: _("Albums");

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar header_bar {
      [end]
      Gtk.MenuButton sort_button {
        icon-name: "view-sort-descending-symbolic";
        tooltip-text: _("Sort");

        accessibility {
          label: _("Sort");
        }
      }
    }

    content: Gtk.Stack stack {
      transition-type: crossfade;

      Gtk.StackPage {
        name: "empty";

        child: Adw.StatusPage empty_page {
          icon-name: "media-optical-cd-audio-symbolic";
          title: _("No Albums");
        };
      }

      Gtk.StackPage {
        name: "syncing";

        child: Adw.StatusPage {
          title: _("Loading Your Library");
          description: _("This only takes a while the first time");

          paintable: Adw.SpinnerPaintable {
            widget: stack;
          };
        };
      }

      Gtk.StackPage {
        name: "grid";

        child: Gtk.ScrolledWindow scrolled {
          hscrollbar-policy: never;

          child: Gtk.GridView grid_view {
            min-columns: 2;
            max-columns: 12;
            single-click-activate: true;

            styles [
              "album-grid",
            ]
          };
        };
      }
    };
  };
}
