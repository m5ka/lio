using Gtk 4.0;
using Adw 1;

template $LioArtistPage: Adw.NavigationPage {
  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {}

    content: Gtk.ScrolledWindow {
      hscrollbar-policy: never;

      child: Adw.Clamp {
        maximum-size: 1100;

        child: Gtk.Box {
          orientation: vertical;
          spacing: 24;
          margin-top: 24;
          margin-bottom: 24;
          margin-start: 12;
          margin-end: 12;

          Gtk.Box header_box {
            spacing: 24;

            Adw.Avatar avatar {
              size: 128;
              show-initials: true;
            }

            Gtk.Box {
              orientation: vertical;
              spacing: 6;
              valign: center;

              Gtk.Label name_label {
                xalign: 0;
                wrap: true;

                styles [
                  "title-1",
                ]
              }

              Gtk.Label meta_label {
                xalign: 0;

                styles [
                  "dim-label",
                ]
              }

              Gtk.Box {
                spacing: 12;
                margin-top: 12;

                Gtk.Button {
                  action-name: "artist.play";

                  child: Adw.ButtonContent {
                    icon-name: "media-playback-start-symbolic";
                    label: _("_Play All");
                    use-underline: true;
                  };

                  styles [
                    "pill",
                    "suggested-action",
                  ]
                }

                Gtk.Button {
                  action-name: "artist.shuffle";

                  child: Adw.ButtonContent {
                    icon-name: "media-playlist-shuffle-symbolic";
                    label: _("_Shuffle");
                    use-underline: true;
                  };

                  styles [
                    "pill",
                  ]
                }
              }
            }
          }

          Gtk.Label {
            label: _("Albums");
            xalign: 0;

            styles [
              "title-3",
            ]
          }

          Gtk.FlowBox albums_box {
            selection-mode: none;
            homogeneous: true;
            min-children-per-line: 2;
            max-children-per-line: 8;
            activate-on-single-click: true;
            row-spacing: 6;
            column-spacing: 6;
          }
        };
      };
    };
  };
}
