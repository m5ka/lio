using Gtk 4.0;
using Adw 1;

template $LioAlbumPage: Adw.NavigationPage {
  title: _("Album");

  styles [
    "album-page",
  ]

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {}

    content: Gtk.Stack stack {
      transition-type: crossfade;

      Gtk.StackPage {
        name: "loading";

        child: Adw.Spinner {
          halign: center;
          valign: center;
          width-request: 32;
          height-request: 32;
        };
      }

      Gtk.StackPage {
        name: "error";

        child: Adw.StatusPage error_page {
          icon-name: "dialog-warning-symbolic";
          title: _("Can't Load Album");
        };
      }

      Gtk.StackPage {
        name: "content";

        child: Gtk.ScrolledWindow {
          hscrollbar-policy: never;

          child: Adw.Clamp {
            maximum-size: 900;
            tightening-threshold: 600;

            child: Gtk.Box {
              orientation: vertical;
              spacing: 24;
              margin-top: 24;
              margin-bottom: 24;
              margin-start: 12;
              margin-end: 12;

              Gtk.Box header_box {
                spacing: 24;

                Adw.Bin cover_bin {
                  valign: start;
                  overflow: hidden;

                  styles [
                    "album-cover",
                    "album-cover-large",
                  ]

                  child: Gtk.Stack cover_stack {
                    Gtk.StackPage {
                      name: "placeholder";

                      child: Gtk.Image {
                        icon-name: "media-optical-cd-audio-symbolic";
                        pixel-size: 96;

                        styles [
                          "dim-label",
                        ]
                      };
                    }

                    Gtk.StackPage {
                      name: "cover";

                      child: Gtk.Image cover_picture {
                        pixel-size: 200;
                      };
                    }
                  };
                }

                Gtk.Box {
                  orientation: vertical;
                  spacing: 6;
                  valign: center;
                  hexpand: true;

                  Gtk.Label title_label {
                    xalign: 0;
                    wrap: true;
                    wrap-mode: word_char;
                    selectable: true;

                    styles [
                      "title-1",
                    ]
                  }

                  Gtk.Button artist_button {
                    halign: start;
                    action-name: "album.go-artist";

                    child: Gtk.Label artist_label {
                      xalign: 0;
                      ellipsize: end;
                    };

                    styles [
                      "flat",
                      "artist-link",
                    ]
                  }

                  Gtk.Label meta_label {
                    xalign: 0;
                    wrap: true;

                    styles [
                      "dim-label",
                    ]
                  }

                  Adw.WrapBox {
                    child-spacing: 12;
                    line-spacing: 12;
                    margin-top: 12;

                    Gtk.Button play_button {
                      action-name: "album.play";

                      child: Adw.ButtonContent {
                        icon-name: "media-playback-start-symbolic";
                        label: _("_Play");
                        use-underline: true;
                      };

                      styles [
                        "pill",
                        "suggested-action",
                      ]
                    }

                    Gtk.Button shuffle_button {
                      action-name: "album.shuffle";

                      child: Adw.ButtonContent {
                        icon-name: "media-playlist-shuffle-symbolic";
                        label: _("_Shuffle");
                        use-underline: true;
                      };

                      styles [
                        "pill",
                      ]
                    }

                    Gtk.ToggleButton download_button {
                      icon-name: "folder-download-symbolic";
                      tooltip-text: _("Download");
                      valign: center;

                      accessibility {
                        label: _("Download");
                      }

                      styles [
                        "circular",
                        "flat",
                      ]
                    }

                    Gtk.Button star_button {
                      action-name: "album.star";
                      icon-name: "non-starred-symbolic";
                      tooltip-text: _("Add to Favourites");
                      valign: center;

                      styles [
                        "circular",
                        "flat",
                      ]

                      accessibility {
                        label: _("Add to Favourites");
                      }
                    }
                  }
                }
              }

              Gtk.ListBox track_list {
                selection-mode: none;

                styles [
                  "boxed-list",
                ]
              }
            };
          };
        };
      }
    };
  };
}
