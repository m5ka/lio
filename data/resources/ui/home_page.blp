using Gtk 4.0;
using Adw 1;

template $LioHomePage: Adw.NavigationPage {
  title: _("Home");
  tag: "home";

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {}

    content: Gtk.Stack stack {
      transition-type: crossfade;

      Gtk.StackPage {
        name: "empty";

        child: Adw.StatusPage empty_page {
          icon-name: "go-home-symbolic";
          title: _("Nothing Here Yet");
          description: _("Albums you add and play will show up here");
        };
      }

      Gtk.StackPage {
        name: "syncing";

        child: Adw.StatusPage {
          title: _("Loading Your Library");
          description: _("This only takes a while the first time");

          paintable: Adw.SpinnerPaintable {
            widget: stack;
          };
        };
      }

      Gtk.StackPage {
        name: "content";

        child: Gtk.ScrolledWindow {
          hscrollbar-policy: never;

          child: Gtk.Box sections_box {
            orientation: vertical;
            spacing: 24;
            margin-top: 18;
            margin-bottom: 24;
          };
        };
      }
    };
  };
}
