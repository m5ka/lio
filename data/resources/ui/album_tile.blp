using Gtk 4.0;
using Adw 1;

template $LioAlbumTile: Gtk.Box {
  orientation: vertical;
  spacing: 6;
  margin-top: 6;
  margin-bottom: 6;
  margin-start: 6;
  margin-end: 6;

  Adw.Bin cover_bin {
    halign: center;
    overflow: hidden;

    styles [
      "album-cover",
    ]

    child: Gtk.Stack cover_stack {
      Gtk.StackPage {
        name: "placeholder";

        child: Gtk.Image {
          icon-name: "media-optical-cd-audio-symbolic";
          pixel-size: 64;

          styles [
            "dim-label",
          ]
        };
      }

      Gtk.StackPage {
        name: "cover";

        child: Gtk.Image cover_picture {
          pixel-size: 160;
        };
      }
    };
  }

  Gtk.Box {
    spacing: 4;

    Gtk.Label title_label {
      xalign: 0;
      ellipsize: end;
      lines: 1;
      hexpand: true;

      styles [
        "heading",
      ]
    }

    Gtk.Image offline_badge {
      icon-name: "folder-download-symbolic";
      visible: false;
      tooltip-text: _("Available offline");

      accessibility {
        label: _("Available offline");
      }

      styles [
        "dim-label",
      ]
    }
  }


  Gtk.Label artist_label {
    xalign: 0;
    ellipsize: end;

    styles [
      "caption",
      "dim-label",
    ]
  }
}
