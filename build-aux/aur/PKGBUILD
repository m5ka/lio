# Maintainer: m5ka <git@m5ka.dev>
#
# AUR package for Lio built from git. After changing this file, regenerate .SRCINFO:
#   makepkg --printsrcinfo > .SRCINFO

pkgname=lio-git
pkgver=0.1.0.r0.g0000000
pkgrel=1
pkgdesc="Fast, native GNOME music player for Navidrome"
arch=('x86_64' 'aarch64')
url="https://github.com/m5ka/lio"
license=('GPL-3.0-or-later')
depends=(
  'dbus'
  'libglvnd'
  'glib2'
  'glycin'
  'gst-plugins-base'
  'gst-plugins-good'
  'gstreamer'
  'gtk4'
  'libadwaita'
  'sqlite'
)
optdepends=(
  'gst-libav: AAC, ALAC and other formats'
  'gst-plugins-bad: additional formats'
)
makedepends=('blueprint-compiler' 'cargo' 'cmake' 'git' 'meson')
provides=('lio')
conflicts=('lio')
# Cargo does its own LTO; makepkg's C LTO flags can break bundled C crates (aws-lc).
options=('!lto')
# libprojectM (third_party/libprojectM) and its projectm-eval are git submodules.
source=(
  "lio::git+https://github.com/m5ka/lio.git"
  "libprojectM::git+https://github.com/projectM-visualizer/projectm.git"
  "projectm-eval::git+https://github.com/projectM-visualizer/projectm-eval.git"
)
sha256sums=('SKIP' 'SKIP' 'SKIP')

pkgver() {
  cd lio
  local desc
  if desc=$(git describe --long --tags --abbrev=7 2>/dev/null); then
    sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g' <<<"$desc"
  else
    printf '0.1.0.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
  fi
}

prepare() {
  cd lio
  git submodule init
  git config submodule.third_party/libprojectM.url "$srcdir/libprojectM"
  git -c protocol.file.allow=always submodule update
  git -C third_party/libprojectM submodule init
  git -C third_party/libprojectM config submodule.vendor/projectm-eval.url "$srcdir/projectm-eval"
  git -C third_party/libprojectM -c protocol.file.allow=always submodule update

  export CARGO_HOME="$srcdir/cargo-home"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  export CARGO_HOME="$srcdir/cargo-home"
  export CARGO_NET_OFFLINE=true
  export RUSTUP_TOOLCHAIN=stable
  arch-meson lio build -Dprofile=default
  meson compile -C build
}

check() {
  export CARGO_HOME="$srcdir/cargo-home"
  export CARGO_NET_OFFLINE=true
  export RUSTUP_TOOLCHAIN=stable
  # Integration tests need a running Navidrome and are #[ignore]d.
  meson test -C build --no-rebuild --print-errorlogs
}

package() {
  meson install -C build --no-rebuild --destdir "$pkgdir"
}
